{
  "name": "m365-copilot-cli",
  "version": "1.0.0",
  "description": "Interactive Linux CLI for Microsoft 365 Copilot (https://m365.cloud.microsoft/) inspired by agy and claude CLI",
  "type": "module",
  "main": "src/index.js",
  "bin": {
    "m365": "./bin/m365.js",
    "m365-copilot": "./bin/m365.js"
  },
  "scripts": {
    "start": "node ./bin/m365.js",
    "login": "node ./bin/m365.js login",
    "status": "node ./bin/m365.js status"
