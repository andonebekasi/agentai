# ==============================================================================
# AgentAI Environment Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# Service Ports (Host bindings)
# ------------------------------------------------------------------------------
# 9Router: AI Gateway Dashboard & OpenAI-compatible endpoint
NINE_ROUTER_PORT=20128

# OpenClaw: Web Gateway / Control UI
OPENCLAW_PORT=18789

# Hermes Agent: Web Dashboard
HERMES_PORT=8088

# NanoClaw: Agent Service Port
NANOCLAW_PORT=18790

# M365 Copilot Agent Router Port (jika menjalankan 'm365 router')
M365_ROUTER_PORT=5365

# ------------------------------------------------------------------------------
# 9Router Settings
# ------------------------------------------------------------------------------
NINE_ROUTER_HOSTNAME=0.0.0.0

# ------------------------------------------------------------------------------
# LLM Provider API Keys & Routing
# ------------------------------------------------------------------------------
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=

# Internal OpenAI-compatible endpoint served by 9Router
ROUTER_BASE_URL=http://9router:20128/v1

# M365 Agent CLI Router endpoint (dari dalam Docker container)
M365_ROUTER_URL=http://host.docker.internal:5365/v1

# ------------------------------------------------------------------------------
# Hermes Agent Configuration
# ------------------------------------------------------------------------------
HERMES_DASHBOARD=true
HERMES_AUTH_USER=admin
HERMES_AUTH_PASS=admin123456

# ------------------------------------------------------------------------------
# OpenClaw Configuration
# ------------------------------------------------------------------------------
OPENCLAW_LOG_LEVEL=info

# ------------------------------------------------------------------------------
# FRP (Fast Reverse Proxy) Configuration
# https://github.com/fatedier/frp
# Digunakan untuk mengekspos service lokal ke Internet melalui VPS publik
# ------------------------------------------------------------------------------
ENABLE_FRP=false
FRP_SERVER_ADDR=127.0.0.1
FRP_SERVER_PORT=7000
FRP_AUTH_TOKEN=change_this_secret_token_agentai

# Port mapping pada remote VPS (bisa disamakan dengan port lokal)
FRP_REMOTE_9ROUTER_PORT=20128
FRP_REMOTE_OPENCLAW_PORT=18789
FRP_REMOTE_HERMES_PORT=8088
FRP_REMOTE_NANOCLAW_PORT=18790
FRP_REMOTE_M365_PORT=5365

